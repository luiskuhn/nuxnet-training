name: nuxnet-training

# conda_env: environment.yml

docker_env:
  image: ghcr.io/luiskuhn/nuxnet-training:latest
  volumes: ["${PWD}/data:/data", "${PWD}/mlruns:/mlruns", "${PWD}/output:/output"]
  environment: [["MLF_CORE_DOCKER_RUN", "TRUE"],["CUBLAS_WORKSPACE_CONFIG", ":4096:8"]]

entry_points:
  main:
    parameters:
      max_epochs: {type: int, default: 1000}
      devices: {type: string, default: "auto"}
      accelerator: {type: string, default: "auto"}
      strategy: {type: string, default: "auto"}
      general-seed: {type: int, default: 0}
      pytorch-seed: {type: int, default: 0}
      log-interval: {type: int, default: 3000}
      lr: {type: float, default: 0.0001}
      lr-scheduler-factor: {type: float, default: 0.5}
      lr-scheduler-patience: {type: int, default: 5}
      lr-scheduler-threshold: {type: float, default: 0.00001}
      lr-scheduler-cooldown: {type: int, default: 2}
      min-lr: {type: float, default: 0.000001}
      training-batch-size: {type: int, default: 1}
      test-batch-size: {type: int, default: 1}
      inference-overlap: {type: float, default: 0.0}
      class-weights: {type: string, default: '1.0,1.0'}
      ce-loss-weight: {type: float, default: 1.0}
      dice-loss-weight: {type: float, default: 1.0}
      cross-validation-folds: {type: int, default: 5}
      validation-fold: {type: int, default: 0}
      test-epochs: {type: int, default: 10}
      dataset-path: {type: string, default: '/data/'}
      n-channels: {type: int, default: 1}
      n-class: {type: int, default: 2}
      num_workers: {type: int, default: 0}
      dropout-rate: {type: float, default: 0.10}
      initial-weights: {type: string, default: 'none'}
      parent-metadata: {type: string, default: 'none'}
      patch-size: {type: string, default: '32,128,128'}
      target-voxel-spacing: {type: string, default: '3.0,1.0,1.0'}
      normalize-input: {type: string, default: '--normalize-input'}
      patches-per-volume: {type: int, default: 8}
      foreground-patch-probability: {type: float, default: 0.8}
      random-rotation-degrees: {type: float, default: 10.0}
      random-rotation-90-probability: {type: float, default: 0.5}
    command: |
          python -m numorph_nuclei_segmentation.numorph_nuclei_segmentation \
            --max_epochs {max_epochs} \
            --devices {devices} \
            --accelerator {accelerator} \
            --strategy {strategy} \
            --general-seed {general-seed} \
            --pytorch-seed {pytorch-seed} \
            --log-interval {log-interval} \
            --lr {lr} \
            --lr-scheduler-factor {lr-scheduler-factor} \
            --lr-scheduler-patience {lr-scheduler-patience} \
            --lr-scheduler-threshold {lr-scheduler-threshold} \
            --lr-scheduler-cooldown {lr-scheduler-cooldown} \
            --min-lr {min-lr} \
            --training-batch-size {training-batch-size} \
            --test-batch-size {test-batch-size} \
            --inference-overlap {inference-overlap} \
            --class-weights {class-weights} \
            --ce-loss-weight {ce-loss-weight} \
            --dice-loss-weight {dice-loss-weight} \
            --cross-validation-folds {cross-validation-folds} \
            --validation-fold {validation-fold} \
            --test-epochs {test-epochs} \
            --dataset-path {dataset-path} \
            --n-channels {n-channels} \
            --n-class {n-class} \
            --num_workers {num_workers} \
            --dropout-rate {dropout-rate} \
            --initial-weights {initial-weights} \
            --parent-metadata {parent-metadata} \
            --patch-size {patch-size} \
            --target-voxel-spacing {target-voxel-spacing} \
            --patches-per-volume {patches-per-volume} \
            --foreground-patch-probability {foreground-patch-probability} \
            --random-rotation-degrees {random-rotation-degrees} \
            --random-rotation-90-probability {random-rotation-90-probability} \
            {normalize-input}
